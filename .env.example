APP_NAME=Bookmarks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bookmarks.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required: the app uses pgvector for embeddings and ilike for search.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bookmarks
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Required. Powers bookmark analysis, embeddings, and chat.
OPENAI_API_KEY=

# Which extracted column feeds AI analysis: markdown_text or extracted_text.
BOOKMARKS_ANALYSIS_SOURCE_COLUMN=markdown_text

# External service used to fetch a Markdown rendering of each bookmarked page.
BOOKMARKS_MARKDOWN_SERVICE_URL=https://markdown.new/
BOOKMARKS_MARKDOWN_SERVICE_METHOD=auto

# Chunking budgets for bookmark analysis, in characters. Lower them to cut cost
# per bookmark, raise them for fewer, larger model calls.
AI_BOOKMARK_ANALYSIS_CHUNK_BUDGET=6000
AI_BOOKMARK_EMBEDDING_CHUNK_BUDGET=4000
AI_BOOKMARK_CHUNK_OVERLAP=500
AI_BOOKMARK_MAX_CHUNKS=12
AI_BOOKMARK_MAX_CANDIDATE_TAGS=20

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
